# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8443                       # the web app (HTTPS), the same inside the container
LAN_IP=192.168.1.20
TZ=Europe/London
APP_URL=https://192.168.1.20:8443
SSL_PROXY=0                          # 1 behind DSM's reverse proxy
UNIFI_IMAGE=lscr.io/linuxserver/unifi-network-application:10.6.106-ls149   # pinned; the window's Updates tab moves it on
DB_IMAGE=mongo:8.0.32                # chosen at the first start: mongo:4.4 where the CPU has no AVX (MongoDB 5 and later need it)
DB_PASSWORD=…                        # UniFi's own database user, made at the first start
DB_ROOT_PASSWORD=…                   # MongoDB's administrator, used by the package for backups
PKG_API_PASS=…                       # the package's read-only UniFi account (dsm-package), for the window's device list
INFORM_PORT=8080                     # device inform; devices that were adopted on another port need set-inform again
STUN_PORT=3478                       # UDP
DISC_PORT=10001                      # UDP; devices always send discovery to 10001
PORTAL=0                             # 1: the guest portal's ports are published
PORTAL_HTTP=8880
PORTAL_HTTPS=8843
PORTAL_HTTP_PUB=127.0.0.1:           # what compose publishes (the port when the portal is on)
PORTAL_HTTPS_PUB=127.0.0.1:
INFORM_HOST=192.168.1.20             # the address UniFi tells devices to inform to (UniFi's "inform host override")
ADMIN_USER=admin                     # the first administrator, made at the first start
ADMIN_EMAIL=you@example.com
COUNTRY=GB                           # Wi-Fi rules follow the country
JAVA_HEAP=1024                       # MB (the Memory tab)
DB_CACHE=0.5                         # GB of MongoDB cache (the Memory tab)
TLS=own                              # own: UniFi's self-signed certificate; dsm: DSM's system-default certificate
TLS_SOURCE=own
DOWN_ALERTS=1                        # a DSM notification when an adopted device has been offline for 10 minutes
